<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || "Sayfa Bulunamadı - 404" %></title>
  <link href="/tailwindout.css" rel="stylesheet">
</head>
<body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white min-h-screen flex flex-col">

<!-- 404 Error Page -->
<main class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8 py-20">
  <div class="text-center">
    <!-- Error Icon -->
    <div class="mb-8">
      <svg class="w-32 h-32 mx-auto text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0112 15c-2.34 0-4.29-1.009-5.824-2.562M15 6.306a7.962 7.962 0 00-6 0m6 0V4a2 2 0 00-2-2h-2a2 2 0 00-2 2v2.306"></path>
      </svg>
    </div>

    <!-- Error Message -->
    <h1 class="text-6xl font-bold text-red-600 dark:text-red-400 mb-4">404</h1>
    <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">Sayfa Bulunamadı</h2>
    
    <p class="text-xl text-gray-600 dark:text-neutral-400 mb-8 max-w-2xl mx-auto">
      <% if (message) { %>
        <%= message %>
      <% } else { %>
        Aradığınız sayfa mevcut değil veya taşınmış olabilir. Lütfen URL'yi kontrol edin veya ana sayfaya dönün.
      <% } %>
    </p>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a href="/" 
         class="inline-flex items-center px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-xl transition-all duration-200 hover:scale-105 shadow-lg">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
        </svg>
        Ana Sayfaya Dön
      </a>
      
      <button onclick="history.back()" 
              class="inline-flex items-center px-6 py-3 bg-gray-600 hover:bg-gray-700 dark:bg-neutral-700 dark:hover:bg-neutral-600 text-white font-semibold rounded-xl transition-all duration-200 hover:scale-105 shadow-lg">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Geri Dön
      </button>
    </div>

    <!-- Popular Links -->
    <div class="mt-16">
      <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-6">Popüler Sayfalar</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
        <a href="/nobetcieczane/istanbul" 
           class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 dark:border-neutral-700 rounded-xl hover:shadow-lg transition-all duration-200 hover:scale-105">
          <h4 class="font-semibold text-gray-900 dark:text-white">İstanbul</h4>
          <p class="text-sm text-gray-600 dark:text-neutral-400">Nöbetçi Eczaneler</p>
        </a>
        
        <a href="/nobetcieczane/ankara" 
           class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 dark:border-neutral-700 rounded-xl hover:shadow-lg transition-all duration-200 hover:scale-105">
          <h4 class="font-semibold text-gray-900 dark:text-white">Ankara</h4>
          <p class="text-sm text-gray-600 dark:text-neutral-400">Nöbetçi Eczaneler</p>
        </a>
        
        <a href="/nobetcieczane/izmir" 
           class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 dark:border-neutral-700 rounded-xl hover:shadow-lg transition-all duration-200 hover:scale-105">
          <h4 class="font-semibold text-gray-900 dark:text-white">İzmir</h4>
          <p class="text-sm text-gray-600 dark:text-neutral-400">Nöbetçi Eczaneler</p>
        </a>
        
        <a href="/nobetcieczane/antalya" 
           class="p-4 bg-white dark:bg-neutral-800 border border-gray-200 dark:border-neutral-700 rounded-xl hover:shadow-lg transition-all duration-200 hover:scale-105">
          <h4 class="font-semibold text-gray-900 dark:text-white">Antalya</h4>
          <p class="text-sm text-gray-600 dark:text-neutral-400">Nöbetçi Eczaneler</p>
        </a>
      </div>
    </div>
  </div>
</main>

</body>
</html>
