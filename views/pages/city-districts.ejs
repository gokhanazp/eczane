<!-- Hero -->
<div class="relative">
  <div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-20">
    <div class="text-center">
      <h1 class="text-4xl sm:text-6xl font-bold text-red-600 dark:text-red-600">
        <%= city %> Nöbetçi Eczaneler
      </h1>

      <h2 class="mt-3 text-gray-600 dark:text-neutral-400">
        <%= city %>'da <%= allDutyPharmaciesCount %> Nöbetçi Eczane - İlçe Seçin
      </h2>

      <div class="mt-7 sm:mt-12 mx-auto max-w-xl relative">
        <!-- SVG Element -->
        <div class="hidden md:block absolute top-0 end-0 -translate-y-12 translate-x-20">
          <svg class="w-16 h-auto text-orange-500" width="121" height="135" viewBox="0 0 121 135" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 16.4754C11.7688 27.4499 21.2452 57.3224 5 89.0164" stroke="currentColor" stroke-width="10" stroke-linecap="round" />
            <path d="M33.6761 112.104C44.6984 98.1239 74.2618 57.6776 83.4821 5" stroke="currentColor" stroke-width="10" stroke-linecap="round" />
            <path d="M50.5525 130C68.2064 127.495 110.731 117.541 116 78.0874" stroke="currentColor" stroke-width="10" stroke-linecap="round" />
          </svg>
        </div>
        <!-- End SVG Element -->

        <!-- SVG Element -->
        <div class="hidden md:block absolute bottom-0 start-0 translate-y-10 -translate-x-32">
          <svg class="w-40 h-auto text-cyan-500" width="347" height="188" viewBox="0 0 347 188" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 82.4591C54.7956 92.8751 30.9771 162.782 68.2065 181.385C112.642 203.59 127.943 78.57 122.161 25.5053C120.504 2.2376 93.4028 -8.11128 89.7468 25.5053C85.8633 61.2125 130.186 199.678 180.982 146.248L214.898 107.02C224.322 95.4118 242.9 79.2851 258.6 107.02C274.299 134.754 299.315 125.589 309.861 117.539L343 93.4426" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
          </svg>
        </div>
        <!-- End SVG Element -->
      </div>
    </div>
  </div>
</div>

<!-- Districts Grid -->
<div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="text-center mb-10">
    <h2 class="text-3xl font-bold text-gray-800 dark:text-white mb-4">
      <%= city %> İlçeleri
    </h2>
    <p class="text-lg text-gray-600 dark:text-neutral-400">
      Nöbetçi eczane aramak istediğiniz ilçeyi seçin
    </p>
  </div>

  <% if (districts && districts.length > 0) { %>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      <% districts.forEach((district, index) => { %>
        <%
          const districtPharmacies = dutyPharmacies[district] || [];
          const pharmacyCount = districtPharmacies.length;
          const districtSlug = district.toLowerCase()
            .replace(/ğ/g, 'g')
            .replace(/ü/g, 'u')
            .replace(/ş/g, 's')
            .replace(/ı/g, 'i')
            .replace(/ö/g, 'o')
            .replace(/ç/g, 'c')
            .replace(/[^a-z0-9]/g, '');
        %>

        <a title="<%= district %> Nöbetçi Eczaneleri" href="/nobetcieczane/<%= city.toLowerCase() %>/<%= districtSlug %>" class="group flex flex-col bg-white border shadow-sm rounded-xl hover:shadow-lg hover:scale-105 focus:outline-none focus:shadow-lg transition-all duration-200 dark:bg-neutral-900 dark:border-neutral-800">
          <div class="p-6 md:p-7">
            <div class="flex justify-between items-center gap-x-3">
              <div class="grow">
                <h3 class="group-hover:text-blue-600 font-semibold text-gray-800 dark:group-hover:text-neutral-400 dark:text-neutral-200">
                  <%= district[0].toLocaleUpperCase('tr-TR') + district.slice(1).toLocaleLowerCase('tr-TR') %>
                </h3>
                <% if (pharmacyCount > 0) { %>
                <div class="flex items-center gap-2 mt-2">
                  <span class="inline-flex items-center justify-center w-8 h-8 bg-red-100 text-red-600 rounded-full text-sm font-bold dark:bg-red-900/20 dark:text-red-400">
                    <%= pharmacyCount %>
                  </span>
                  <p class="text-sm font-medium text-gray-600 dark:text-neutral-400">
                    Nöbetçi Eczane
                  </p>
                </div>
                <% } else { %>
                <div class="flex items-center gap-2 mt-2">
                  <span class="inline-flex items-center justify-center w-8 h-8 bg-gray-100 text-gray-500 rounded-full text-sm font-bold dark:bg-gray-800 dark:text-gray-400">
                    0
                  </span>
                  <p class="text-sm font-medium text-gray-500 dark:text-neutral-500">
                    Eczane Yok
                  </p>
                </div>
                <% } %>
              </div>
              <div class="shrink-0">
                <svg class="shrink-0 size-5 text-gray-800 dark:text-white" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </div>
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  <% } else { %>
    <div class="text-center py-12">
      <div class="max-w-md mx-auto">
        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0112 15c-2.34 0-4.29-1.009-5.824-2.562M15 6.306a7.962 7.962 0 00-6 0m6 0V4a2 2 0 00-2-2h-2a2 2 0 00-2 2v2.306"></path>
        </svg>
        <h3 class="text-xl font-semibold text-gray-800 mb-2 dark:text-white">
          Nöbetçi Eczane Bulunamadı
        </h3>
        <p class="text-gray-600 dark:text-neutral-400">
          <%= city %> için şu anda nöbetçi eczane bilgisi bulunmamaktadır.
        </p>
      </div>
    </div>
  <% } %>
</div>

<!-- Info Section -->
<div class="bg-gray-50 dark:bg-neutral-800">
  <div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid md:grid-cols-2 gap-8">
      <div>
        <h3 class="text-2xl font-semibold text-gray-800 mb-4 dark:text-white">
          <%= city %> Nöbetçi Eczane Rehberi
        </h3>
        <p class="text-gray-600 leading-relaxed dark:text-neutral-400">
          <%= city %>'da acil ilaç ihtiyaçlarınız için nöbetçi eczaneler 7/24 hizmetinizdedir. 
          İlçenizi seçerek size en yakın nöbetçi eczaneyi bulabilir, adres ve telefon bilgilerine ulaşabilirsiniz.
        </p>
      </div>
      
      <div>
        <h3 class="text-2xl font-semibold text-gray-800 mb-4 dark:text-white">
          Nasıl Kullanılır?
        </h3>
        <ul class="space-y-2 text-gray-600 dark:text-neutral-400">
          <li class="flex items-center space-x-2">
            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>İlçenizi seçin</span>
          </li>
          <li class="flex items-center space-x-2">
            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Nöbetçi eczaneleri görüntüleyin</span>
          </li>
          <li class="flex items-center space-x-2">
            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Telefon arayın veya yol tarifi alın</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

<!-- Back to Cities -->
<div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="text-center">
    <a href="/" 
       class="inline-flex items-center space-x-2 text-blue-600 hover:text-blue-800 font-semibold transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <span>Diğer Şehirlere Dön</span>
    </a>
  </div>
</div>
