<% if (districts === undefined || districts.length === 0) { %>
<div class="text-center py-12">
  <div class="mb-6">
    <svg class="animate-pulse w-16 h-16 mx-auto text-red-600" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path>
    </svg>
  </div>
  <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-200 mb-2">Eczane Verileri Hazırlanıyor</h3>
  <p class="text-gray-600 dark:text-gray-400 mb-4">Güncel nöbetçi eczane bilgileri getiriliyor...</p>
  <div class="inline-flex items-center px-4 py-2 bg-red-50 dark:bg-red-900/20 rounded-lg">
    <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-red-600 mr-2"></div>
    <span class="text-sm text-red-600 dark:text-red-400 font-medium">Yükleniyor</span>
  </div>
</div>
<% } else { %>

<div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-5 ">
  <!-- Grid - 3 Eczane Yan Yana -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
    <!-- Card -->
    <% districts.forEach(district => { %>
    <a title="<%=district%> Nöbetçi Eczaneleri" href="/nobetcieczane/<%=city%>/<%=district%>" class="group flex flex-col bg-white border shadow-sm rounded-xl hover:shadow-lg hover:scale-105 focus:outline-none focus:shadow-lg transition-all duration-200 dark:bg-neutral-900 dark:border-neutral-800" href="#">
      <div class="p-6 md:p-7">
        <div class="flex justify-between items-center gap-x-3">
          <div class="grow">
            <h3 class="group-hover:text-blue-600 font-semibold text-gray-800 dark:group-hover:text-neutral-400 dark:text-neutral-200">
              <%= district[0].toLocaleUpperCase('tr-TR') + district.slice(1).toLocaleLowerCase('tr-TR') %>
            </h3>
            <% if (dutyPharmacies && dutyPharmacies[district] && dutyPharmacies[district].length > 0) { %>
            <div class="flex items-center gap-2 mt-2">
              <span class="inline-flex items-center justify-center w-8 h-8 bg-red-100 text-red-600 rounded-full text-sm font-bold dark:bg-red-900/20 dark:text-red-400">
                <%= dutyPharmacies[district].length %>
              </span>
              <p class="text-sm font-medium text-gray-600 dark:text-neutral-400">
                Nöbetçi Eczane
              </p>
            </div>
            <% } else { %>
            <div class="flex items-center gap-2 mt-2">
              <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-red-600"></div>
              <p class="text-sm text-red-500 dark:text-red-400">
                Yükleniyor...
              </p>
            </div>
            <% } %>
          </div>
          <div>
            <svg class="shrink-0 size-5 text-gray-800 dark:text-neutral-200" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </div>
        </div>
      </div>
    </a>
    <% }); %>
    <!-- End Card -->
  </div>
  <!-- End Grid -->
</div>
<!-- End Card Section -->
<% } %>