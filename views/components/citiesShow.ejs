<% if (cities === undefined | cities.length === 0) { %>
<div class="text-center py-12">
  <h3 class="text-2xl font-bold text-gray-800 dark:text-white">Şehir bulunamadı</h3>
</div>
<% } else { %>

<!-- Cities Section -->
<div class="py-12 cities-section" style="background: none !important; background-color: transparent !important;">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8" style="background: none !important; background-color: transparent !important;">
    <!-- Section Header -->
    <div class="text-center mb-8">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
        Türkiye'deki Tüm İller
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
        81 ilde bulunan nöbetçi eczanelere hızlıca ulaşın. İlinizi seçerek güncel nöbetçi eczane listesini görüntüleyin.
      </p>
    </div>

    <!-- Cities Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
      <% cities.forEach(city => { %>
      <a title="<%=city%> Nöbetçi Eczaneleri"
         href="/nobetcieczane/<%=city%>"
         class="group border border-gray-200 dark:border-gray-700 rounded-lg p-3 hover:shadow-md hover:border-red-300 dark:hover:border-red-600 transition-all duration-200 transform hover:scale-105">

        <!-- City Info -->
        <div class="flex items-center justify-between">
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors mb-1">
              <%= city[0].toLocaleUpperCase('tr-TR') + city.slice(1).toLocaleLowerCase('tr-TR') %>
            </h3>

            <% if (pharmacyByCities && pharmacyByCities[city]) { %>
            <div class="flex items-center gap-x-2">
              <div class="w-2 h-2 bg-green-500 rounded-full"></div>
              <p class="text-sm text-gray-600 dark:text-gray-400">
                <%= pharmacyByCities[city] %> nöbetçi eczane
              </p>
            </div>
            <% } else { %>
            <div class="flex items-center gap-x-2">
              <div class="w-2 h-2 bg-gray-400 rounded-full"></div>
              <p class="text-sm text-gray-500 dark:text-gray-500">
                Veri yükleniyor...
              </p>
            </div>
            <% } %>
          </div>

          <!-- Arrow Icon -->
          <div>
            <svg class="w-4 h-4 text-gray-400 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </div>
      </a>
      <% }); %>
    </div>

    <!-- Bottom Info -->
    <div class="text-center mt-8">
      <p class="text-sm text-gray-500 dark:text-gray-400">
        Güncel nöbetçi eczane bilgileri T.C. Sağlık Bakanlığı'ndan alınmaktadır.
      </p>
    </div>
  </div>
</div>
<% } %>