

<!-- Breadcrumb -->
<div class="bg-gray-50 dark:bg-neutral-800 py-4">
  <div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="flex" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a href="/" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-red-600 dark:text-gray-400 dark:hover:text-white">
            <svg class="w-3 h-3 mr-2.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
              <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
            </svg>
            Ana Sayfa
          </a>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="rtl:rotate-180 w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            <a href="/nobetcieczane/<%= cityName %>" class="ml-1 text-sm font-medium text-gray-700 hover:text-red-600 md:ml-2 dark:text-gray-400 dark:hover:text-white">
              <%= cityName.charAt(0).toUpperCase() + cityName.slice(1) %>
            </a>
          </div>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <svg class="rtl:rotate-180 w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2 dark:text-gray-400">
              <%= pharmacy.name %>
            </span>
          </div>
        </li>
      </ol>
    </nav>
  </div>
</div>

<!-- Main Content -->
<main class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <!-- Hero Section -->
  <div class="text-center mb-10">
    <h1 class="text-4xl sm:text-5xl font-bold text-red-600 dark:text-red-600 mb-4">
      <%= pharmacy.name %>
    </h1>
    <p class="text-xl text-gray-600 dark:text-neutral-400 mb-6">
      <%= pharmacy.district || 'Merkez' %>, <%= cityName.charAt(0).toUpperCase() + cityName.slice(1) %>
    </p>
    <div class="inline-flex items-center bg-green-100 text-green-800 px-6 py-3 rounded-full font-semibold dark:bg-green-900/20 dark:text-green-400">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      Nöbetçi Eczane
    </div>
  </div>

  <!-- Pharmacy Info Card -->
  <div class="bg-white dark:bg-neutral-900 rounded-2xl shadow-lg border border-gray-200 dark:border-neutral-700 p-8 mb-8">

    <!-- Contact Info -->
    <div class="grid md:grid-cols-2 gap-8 mb-8">
      <div class="space-y-6">
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">İletişim Bilgileri</h3>

        <!-- Phone -->
        <div class="flex items-center space-x-4 p-6 bg-gray-50 dark:bg-neutral-800 rounded-xl border border-gray-200 dark:border-neutral-700">
          <div class="flex-shrink-0">
            <div class="w-12 h-12 bg-red-100 dark:bg-red-900/20 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
          </div>
          <div class="flex-1">
            <p class="text-sm font-medium text-gray-600 dark:text-neutral-400">Telefon</p>
            <% if (pharmacy.phone && pharmacy.phone.trim() && pharmacy.phone !== '0 - () -') { %>
              <a href="tel:<%= pharmacy.phone.replace(/[^0-9]/g, '') %>"
                 class="text-lg font-semibold text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300">
                <%= pharmacy.phone %>
              </a>
            <% } else { %>
              <p class="text-lg text-gray-500 dark:text-neutral-500">Telefon bilgisi yok</p>
            <% } %>
          </div>
        </div>

        <!-- Address -->
        <div class="flex items-start space-x-4 p-6 bg-gray-50 dark:bg-neutral-800 rounded-xl border border-gray-200 dark:border-neutral-700">
          <div class="flex-shrink-0 mt-1">
            <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/20 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
          </div>
          <div class="flex-1">
            <p class="text-sm font-medium text-gray-600 dark:text-neutral-400">Adres</p>
            <p class="text-lg font-medium text-gray-900 dark:text-white leading-relaxed"><%= pharmacy.address %></p>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="space-y-6">
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Hızlı İşlemler</h3>

        <!-- Call Button -->
        <% if (pharmacy.phone && pharmacy.phone.trim() && pharmacy.phone !== '0 - () -') { %>
          <a href="tel:<%= pharmacy.phone.replace(/[^0-9]/g, '') %>"
             class="bg-red-600 hover:bg-red-700 text-white px-6 py-4 rounded-xl font-semibold flex items-center justify-center space-x-3 w-full transition-all duration-200 hover:scale-105 shadow-lg">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <span>Hemen Ara</span>
          </a>
        <% } %>

        <!-- Directions Button -->
        <a href="https://www.google.com/maps/search/<%= encodeURIComponent(pharmacy.name + ' ' + pharmacy.address + ' ' + cityName) %>"
           target="_blank" rel="noopener noreferrer"
           class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-4 rounded-xl font-semibold flex items-center justify-center space-x-3 w-full transition-all duration-200 hover:scale-105 shadow-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
          </svg>
          <span>Yol Tarifi Al</span>
        </a>

        <!-- Share Button -->
        <button onclick="sharePharmacy()"
                class="bg-gray-600 hover:bg-gray-700 dark:bg-neutral-700 dark:hover:bg-neutral-600 text-white px-6 py-4 rounded-xl font-semibold flex items-center justify-center space-x-3 w-full transition-all duration-200 hover:scale-105 shadow-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"></path>
          </svg>
          <span>Paylaş</span>
        </button>
      </div>
    </div>

            <!-- Additional Info -->
            <div class="border-t pt-6">
                <h3 class="text-xl font-semibold text-gray-900 mb-4">Önemli Bilgiler</h3>
                <div class="grid md:grid-cols-2 gap-4 text-sm text-gray-600">
                    <div class="flex items-center space-x-2">
                        <i class="fas fa-info-circle text-blue-500"></i>
                        <span>Nöbetçi eczane bilgileri günlük güncellenir</span>
                    </div>
                    <div class="flex items-center space-x-2">
                        <i class="fas fa-clock text-green-500"></i>
                        <span>24 saat hizmet verir</span>
                    </div>
                    <div class="flex items-center space-x-2">
                        <i class="fas fa-prescription-bottle-alt text-purple-500"></i>
                        <span>Reçeteli ve reçetesiz ilaçlar</span>
                    </div>
                    <div class="flex items-center space-x-2">
                        <i class="fas fa-shield-alt text-red-500"></i>
                        <span>Acil durumlarda hizmet verir</span>
                    </div>
                </div>
            </div>
        </div>

  </div>

  <!-- Back Button -->
  <div class="text-center mt-12">
    <a href="/nobetcieczane/<%= cityName %>"
       class="inline-flex items-center space-x-2 bg-gray-100 hover:bg-gray-200 dark:bg-neutral-800 dark:hover:bg-neutral-700 text-gray-700 dark:text-white px-6 py-3 rounded-xl font-semibold transition-all duration-200 hover:scale-105">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <span><%= cityName.charAt(0).toUpperCase() + cityName.slice(1) %> Nöbetçi Eczanelere Dön</span>
    </a>
  </div>
</main>

<script>
  function sharePharmacy() {
    if (navigator.share) {
      navigator.share({
        title: '<%= title %>',
        text: '<%= description %>',
        url: window.location.href
      });
    } else {
      // Fallback: Copy to clipboard
      navigator.clipboard.writeText(window.location.href).then(() => {
        alert('Eczane linki panoya kopyalandı!');
      });
    }
  }
</script>
